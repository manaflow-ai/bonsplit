    "example.sample.appKit" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "import AppKit\n\nfinal class MyViewController: NSViewController {\n    override func loadView() {\n        view = NSTextField(labelWithString: \"Hello from tab %d\")\n    }\n}" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "import AppKit\n\nfinal class MyViewController: NSViewController {\n    override func loadView() {\n        view = NSTextField(labelWithString: \"タブ%dからこんにちは\")\n    }\n}" } }
      }
    },
    "example.sample.document" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "struct Document: Identifiable {\n    let id = UUID()\n    var title: String\n    var content: String\n    var isDirty: Bool = false\n}\n\nclass DocumentManager {\n    var documents: [Document] = []\n\n    func save(_ document: Document) {\n        // Save implementation\n    }\n}" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "struct Document: Identifiable {\n    let id = UUID()\n    var title: String\n    var content: String\n    var isDirty: Bool = false\n}\n\nclass DocumentManager {\n    var documents: [Document] = []\n\n    func save(_ document: Document) {\n        // 保存処理\n    }\n}" } }
      }
    },
    "example.sample.fibonacci" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "func fibonacci(_ n: Int) -> Int {\n    guard n > 1 else { return n }\n    return fibonacci(n - 1) + fibonacci(n - 2)\n}\n\nlet result = fibonacci(10)\nprint(\"Fibonacci(10) = \\(result)\")" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "func fibonacci(_ n: Int) -> Int {\n    guard n > 1 else { return n }\n    return fibonacci(n - 1) + fibonacci(n - 2)\n}\n\nlet result = fibonacci(10)\nprint(\"フィボナッチ(10) = \\(result)\")" } }
      }
    },
    "example.sample.notes" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "# Notes\n\nThis is a sample document.\n\n## Features\n\n- Drag and drop tabs\n- Split panes\n- Keyboard navigation\n\n## Tips\n\nTry dragging a tab to the edge of a pane to create a split!" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "# メモ\n\nこれはサンプル文書です。\n\n## 機能\n\n- タブのドラッグ＆ドロップ\n- ペイン分割\n- キーボードナビゲーション\n\n## ヒント\n\nタブをペインの端へドラッグして分割してみてください。" } }
      }
    },
    "example.sample.welcome" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "// Welcome to Bonsplit Example!\n\n// Try these actions:\n// - ⌘T to create a new tab\n// - ⌘W to close the current tab\n// - ⌘⇧D to split right\n// - ⌘⌥D to split down\n// - Drag tabs to reorder or move between panes\n// - ⌘⌥←→↑↓ to navigate between panes\n\nlet greeting = \"Hello, World!\"\nprint(greeting)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "// Bonsplit Exampleへようこそ！\n\n// 操作を試してください:\n// - ⌘T: 新しいタブ\n// - ⌘W: 現在のタブを閉じる\n// - ⌘⇧D: 右に分割\n// - ⌘⌥D: 下に分割\n// - タブをドラッグして並べ替えまたはペイン間を移動\n// - ⌘⌥←→↑↓: ペイン間を移動\n\nlet greeting = \"こんにちは、世界！\"\nprint(greeting)" } }
      }
    },
